# Copy this file to backend/.env and edit the values.
# Windows (PowerShell, from the project root):  copy .env.example backend\.env
# Never commit the real .env file to Git.

# --- Security (REQUIRED) ---
# Generate a long random value with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
ACCESS_TOKEN_MINUTES=120

# First administrator account, created automatically when the backend starts.
# Choose your own values. Use a strong password.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Browser addresses allowed to call the API (the React dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Local LLM (Ollama) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
LLM_TEMPERATURE=0.2
LLM_TIMEOUT_SECONDS=120

# --- RAG settings ---
# sentence-transformers = real semantic embeddings (use this).
# hashing = tiny offline fallback used ONLY by automated tests.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
CHUNK_WORDS=180
CHUNK_OVERLAP_WORDS=40
TOP_K=4
# Minimum similarity (0 to 1) for a passage to be used. Raise it for stricter answers.
MIN_SIMILARITY=0.30

# --- Storage (defaults are inside the data/ folder) ---
# DATABASE_PATH=
# UPLOAD_DIR=
# CHROMA_DIR=
MAX_UPLOAD_MB=10
